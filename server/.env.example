# ---------- Database (Supabase) ----------
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Use the Session/Transaction pooler URI and keep ?sslmode=require
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require"

# ---------- Sessions ----------
SESSION_SECRET="change-me-to-a-long-random-string"

# ---------- OAuth (localhost) ----------
# Google Cloud Console → Credentials → OAuth 2.0 Client
#   Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub → Settings → Developer settings → OAuth Apps
#   Authorization callback URL: http://localhost:4000/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---------- App ----------
# Dev (Vite dev server): http://localhost:5173
# Single-origin mode (Express serves client/dist): http://localhost:4000
CLIENT_URL="http://localhost:5173"
PORT=4000
# Base URL the OAuth consoles register as the redirect callback.
# Keep it http://localhost:4000 for local dev (works from either dev host).
PUBLIC_BASE_URL="http://localhost:4000"

# ---------- LLM (central OSS model via free inference API) ----------
# OpenAI-compatible chat/completions endpoint. Leave LLM_API_KEY empty for
# keyless mode — diagnosis degrades gracefully to rules-only.
LLM_API_URL="https://openrouter.ai/api/v1"
LLM_API_KEY=""
LLM_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# ---------- RAG pipeline (FastAPI + Chroma — ./rag_pipeline) ----------
# Start it with ./start-rag.sh → health at $RAG_SERVICE_URL/health
RAG_SERVICE_URL="http://127.0.0.1:8000"
# Shared secret the server sends as X-Internal-Token; the RAG service rejects
# suggestion requests without it. Generate with: openssl rand -hex 32
RAG_SERVICE_TOKEN=""
# The Python service reads this same server/.env as its central env.
# Get a key at console.groq.com — used for schema-fix suggestions.
GROQ_API_KEY=""
GROQ_MODEL=""
