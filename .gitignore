# See https://github.com/github/ gitignore/blob/main/Node.gitignore for Node entries
node_modules/
npm-debug.log*
yarn-error.log*

# Production build output
dist/
build/

# Environment variables (containing OAuth credentials, DB passwords, etc.)
# Covers .env, .env.local, .env.production, .env.development — any variant.
.env*
# ...but keep the template, which is tracked and contains only placeholders.
!.env.example

# Local database file (if any)
*.sqlite3

# Favicon (generated during development, not tracked in git)
favicon.ico

# Vite client-side cache
.vite/

# TypeScript temporary files
*.tsbuildinfo
*.tslock

# IDE / editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# Docker (if used)
docker-compose.yml
.dockerignore

# OAuth token caches and temp files
token*.json

PART1_CHECKLIST.md
PART1_IMPLEMENTATION_PLAN.md
SESSION_SUMMARY.md
LAST_SUMMARY
.playwright-mcp/
part1.md